# Copy to .env and fill in. Never commit .env.

# Google Workspace user SMTP (smtp.gmail.com) or org relay (smtp-relay.gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Xerox on the LAN
PRINTER_HOST=192.168.68.52
SCAN_DIR=
DASH_PORT=8765

# Optional extra @nexdash.com addresses for autocomplete. SES identities are loaded too.
WORKSPACE_EMAILS=
