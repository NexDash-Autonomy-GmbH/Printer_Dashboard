{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "printer-api",
  // Parth@nexdash.com's Account, where nexdash.com lives. Moved from Alwin's
  // so scan mail can use the send_email binding for noreply@nexdash.com,
  // which only sends from domains onboarded in the Worker's own account.
  "account_id": "18b41dc63c29cf3652cfddec8278368f",
  "main": "index.ts",
  "compatibility_date": "2026-08-31",
  // The ESP8266 bridge polls this hostname directly and cannot do SSO, so it
  // has to stay reachable — turning it off 404'd /bridge/* and stopped the
  // printer scanning. Keeping it on no longer reopens /api/*: ACCESS_AUD is
  // set, so the Worker verifies the Access assertion itself on every /api/*
  // request rather than relying on the hostname being unreachable.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Scan mail goes out from the same no-reply address and name as NexOS.
    "MAIL_FROM_EMAIL": "noreply@nexdash.com",
    "MAIL_FROM_NAME": "NexDash OS",
    // Where download links for scans too big to attach point. A nexdash.com
    // name, not workers.dev, so links survive any future move.
    "SCAN_LINK_BASE": "https://printer-api.nexdash.com",
    "PRINTER_HOST": "192.168.68.52",
    "CORS_ORIGINS": "https://printer-dashboard.pages.dev",
    // Neither is a credential: the team domain is public and the AUD tag
    // only identifies which Access app a token must have been issued for.
    "ACCESS_TEAM_DOMAIN": "nexdash.cloudflareaccess.com",
    "ACCESS_AUD": "69e1daf4d35b5772413cb4e82c64d03cef820e91d0d3f5aee700edb7e0129ba0",
    // Recipient lists are per signed-in person. The one list that existed
    // before namespacing is handed to this address on their first read.
    "LEGACY_RECIPIENTS_OWNER": "alwin@nexdash.com"
  },
  // Uploaded PDFs wait here until the bridge prints them, then are deleted.
  // KV caps a value at 25 MB, which is the upload limit the UI enforces too.
  "kv_namespaces": [
    {
      "binding": "PRINT_FILES",
      "id": "424b12ad075740d6a2408de6f94f9bfb"
    },
    // Scans over the 5 MiB mail limit, served from /scans/<id>/ for 30 days.
    {
      "binding": "SCAN_FILES",
      "id": "2bdea914d26a43bf9a5894cdb3d70798"
    }
  ],
  // Locked to the one sender, so nothing else can be sent as nexdash.com.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@nexdash.com"]
    }
  ],
  // The bridge and scan links use this. Everyone else reaches the Worker
  // through the dashboard's service binding.
  "routes": [
    {
      "pattern": "printer-api.nexdash.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRINTER_API",
        "class_name": "PrinterApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrinterApi"]
    }
  ]
}
