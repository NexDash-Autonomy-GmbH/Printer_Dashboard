{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "printer-api",
  "main": "index.ts",
  "compatibility_date": "2026-08-31",
  // The ESP8266 bridge polls this hostname directly and cannot do SSO, so it
  // has to stay reachable — turning it off 404'd /bridge/* and stopped the
  // printer scanning. Keeping it on no longer reopens /api/*: ACCESS_AUD is
  // set, so the Worker verifies the Access assertion itself on every /api/*
  // request rather than relying on the hostname being unreachable.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "587",
    "PRINTER_HOST": "192.168.68.52",
    "CORS_ORIGINS": "https://printer-dashboard.pages.dev",
    // Neither is a credential: the team domain is public and the AUD tag
    // only identifies which Access app a token must have been issued for.
    "ACCESS_TEAM_DOMAIN": "nexdash.cloudflareaccess.com",
    "ACCESS_AUD": "69e1daf4d35b5772413cb4e82c64d03cef820e91d0d3f5aee700edb7e0129ba0"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRINTER_API",
        "class_name": "PrinterApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrinterApi"]
    }
  ]
}
